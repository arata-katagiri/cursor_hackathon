# BroQuest environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.

# --- AI (Anthropic) ---
# Used server-side only for AI quest generation. Do NOT prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Default model for quest generation. Quality: claude-opus-4-8. Cheap/fast: claude-haiku-4-5
ANTHROPIC_MODEL=claude-opus-4-8

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (TBD — see PRD Open Questions) ---
# DATABASE_URL=

# --- Auth (TBD) ---
# AUTH_SECRET=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

